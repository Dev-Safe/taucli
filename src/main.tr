from mod import parser, Command, ParseResult

def main(args:  List[str]) throws str -> int:
    args.remove(0)
    result: Result[ParseResult, str] =  parser("taupkg", "Tauraro package manager")
        .subcommand(
            Command.init("build", "Compile the project")
                .opt_str_arg("target", "Target architecture")
                .toggle_flag("r,release", "Compile in release mode")
                .str_flag("o,output", "Output directory")
        ).parse(args)
    ret: Result[int, str] = result.unwrap().handle()
    return int(ret.unwrap())
